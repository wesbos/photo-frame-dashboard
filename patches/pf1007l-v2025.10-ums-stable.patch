Apply on top of pf1007l-uboot.patch. Makes the backup UMS session stable on
Linux hosts and deterministic: the FEL script hook did not run on one unit
(fell through to the fastboot gadget, then hung in 52 MHz eMMC reads), so the
UMS command is the boot command itself. See the doc section added in this
commit for the Linux-host report.

--- a/configs/pf1007l_backup_defconfig
+++ b/configs/pf1007l_backup_defconfig
@@ -13,3 +13,4 @@
 CONFIG_USB_MUSB_GADGET=y
 CONFIG_CMD_USB_MASS_STORAGE=y
 CONFIG_CRC32_VERIFY=y
+CONFIG_BOOTCOMMAND="ums 0 mmc 0,1"
--- a/arch/arm/dts/sun8i-a33-pf1007l-backup.dts
+++ b/arch/arm/dts/sun8i-a33-pf1007l-backup.dts
@@ -1,4 +1,5 @@
 &mmc2 {
+	max-frequency = <25000000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&mmc2_8bit_pins>;
 	vmmc-supply = <&reg_dcdc1>;
--- a/drivers/usb/gadget/f_mass_storage.c
+++ b/drivers/usb/gadget/f_mass_storage.c
@@ -9,7 +9,9 @@
 		return -EINVAL;
 	}
 
-	common->eject = 1;
+	/* Only an unload request ejects; start and idle-stop keep UMS active. */
+	if ((common->cmnd[4] & 0x03) == 0x02)
+		common->eject = 1;
 
 	return 0;
 }
