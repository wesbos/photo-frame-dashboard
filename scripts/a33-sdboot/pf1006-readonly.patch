+		return 0;
+	}
 
 	err = blk_select_hwpart_devnum(UCLASS_MMC, dev_num,
 				       block_dev->hwpart);
@@ -233,6 +239,12 @@
 	if (!mmc)
 		return 0;
 
+	/* Do not write or erase non-SD media, at any device index. */
+	if (!IS_SD(mmc)) {
+		puts("pf1006 diagnostic: refused non-SD block write\n");
+		return 0;
