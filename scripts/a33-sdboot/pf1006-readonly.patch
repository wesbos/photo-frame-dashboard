diff --git a/drivers/mmc/mmc.c b/drivers/mmc/mmc.c
--- a/drivers/mmc/mmc.c
+++ b/drivers/mmc/mmc.c
@@ -853,6 +853,23 @@
 			      (index == EXT_CSD_PART_CONF);
 	int ret;
 
+	/*
+	 * Permit only volatile MMC settings needed to read the device.
+	 * Keep all other PART_CONF bits when changing PARTITION_ACCESS.
+	 * Refuse boot write protection, BKOPS, reset-function changes,
+	 * hardware partitioning, and other persistent EXT_CSD changes.
+	 */
+	bool allowed_switch = set == EXT_CSD_CMD_SET_NORMAL &&
+		(index == EXT_CSD_BUS_WIDTH || index == EXT_CSD_HS_TIMING ||
+		 (index == EXT_CSD_ERASE_GROUP_DEF && value <= 1) ||
+		 (index == EXT_CSD_PART_CONF &&
+		  (value & ~7) == (mmc->part_config & ~7)));
+
+	if (!IS_SD(mmc) && !allowed_switch) {
+		puts("pf1006 diagnostic: refused persistent EXT_CSD change\n");
+		return -EPERM;
+	}
+
 	if (mmc->gen_cmd6_time)
 		timeout_ms = mmc->gen_cmd6_time * 10;
 
