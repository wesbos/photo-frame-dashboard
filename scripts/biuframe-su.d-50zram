#!/system/bin/sh
# Resize zram swap from the stock 128 MB to 512 MB (run at boot by SuperSU su.d).
Z=/sys/block/zram0
[ "$(cat $Z/disksize)" = 536870912 ] && exit 0
swapoff /dev/block/zram0
echo 1 > $Z/reset
echo 4 > $Z/max_comp_streams
echo 536870912 > $Z/disksize
mkswap /dev/block/zram0
swapon /dev/block/zram0
