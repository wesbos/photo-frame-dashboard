# Experimental PF1006 read probe. Not tested on hardware.
# Use only with the companion U-Boot build. It blocks non-SD writes and erases,
# stops on PMIC errors, and requires at least 256 MiB RAM before loading U-Boot.
# The build replaces @RUN_ID@ with a new token. Use each prepared card for one boot.
# Buffers use DRAM offsets 32..40 MiB; status uses +48 MiB; this script uses +49 MiB.
# Write files only to FAT mmc 0:1. Confirm that candidate mmc 1 is not SD before
# reading it. Do not export its CID, serial number, or the full environment.
# Hardware settings are not verified for PF1006. This is not a full backup or an
# ADB installer. U-Boot still changes PMIC, DRAM, and MMC controller settings.

setenv pf1006_a 0x42000000
setenv pf1006_b 0x42400000
setenv pf1006_e 0x43000000
setenv pf1006_format 1
setenv pf1006_run_id @RUN_ID@
setenv pf1006_stage started
setenv pf1006_result RUNNING
setenv pf1006_start_sector 0
setenv pf1006_sector_count 0x2000
setenv pf1006_read_bytes 0x400000
setenv pf1006_read1_sha256 pending
setenv pf1006_read2_sha256 pending
setenv pf1006_reread not_run
setenv pf1006_card_verify not_run
setenv pf1006_media unconfirmed
setenv pf1006_extcsd_status unavailable
setenv pf1006_extcsd_rev unknown
setenv pf1006_extcsd_sec0 unknown
setenv pf1006_extcsd_sec1 unknown
setenv pf1006_extcsd_sec2 unknown
setenv pf1006_extcsd_sec3 unknown
setenv pf1006_save 'env export -t ${pf1006_e} pf1006_format pf1006_run_id pf1006_stage pf1006_result pf1006_start_sector pf1006_sector_count pf1006_read_bytes pf1006_read1_sha256 pf1006_read2_sha256 pf1006_reread pf1006_card_verify pf1006_media pf1006_extcsd_status pf1006_extcsd_rev pf1006_extcsd_sec0 pf1006_extcsd_sec1 pf1006_extcsd_sec2 pf1006_extcsd_sec3 && fatwrite mmc 0:1 ${pf1006_e} pf1006-probe-status.txt ${filesize}'

if run pf1006_save; then
  if mmc dev 1; then
    if mmc reg read ocr 0 pf1006_ocr; then
      setenv pf1006_media mmc
    else
      setenv pf1006_result FAIL_NOT_CONFIRMED_MMC
    fi
  else
    setenv pf1006_result FAIL_SELECT_MMC1
  fi
else
  setenv pf1006_result FAIL_INITIAL_STATUS
fi

# EXT_CSD metadata is optional. Export bytes as hexadecimal; read SEC_COUNT in
# little-endian order. The OCR command above succeeds only for MMC, not SD.
if test "${pf1006_result}" = RUNNING; then
  if mmc reg read extcsd 192 pf1006_extcsd_rev && mmc reg read extcsd 212 pf1006_extcsd_sec0 && mmc reg read extcsd 213 pf1006_extcsd_sec1 && mmc reg read extcsd 214 pf1006_extcsd_sec2 && mmc reg read extcsd 215 pf1006_extcsd_sec3; then
    setenv pf1006_extcsd_status available
  fi
  setenv pf1006_stage reading
  if run pf1006_save; then
    # fatwrite can select the SD device. Select MMC 1 again before the reads.
    if mmc dev 1; then
      if mw.b ${pf1006_a} 0xcc ${pf1006_read_bytes} && mw.b ${pf1006_b} 0x33 ${pf1006_read_bytes}; then
        if mmc read ${pf1006_a} 0 ${pf1006_sector_count}; then
          if mmc read ${pf1006_b} 0 ${pf1006_sector_count}; then
            if cmp.b ${pf1006_a} ${pf1006_b} ${pf1006_read_bytes}; then
              setenv pf1006_reread equal
              if hash sha256 ${pf1006_a} ${pf1006_read_bytes} pf1006_read1_sha256 && hash sha256 ${pf1006_b} ${pf1006_read_bytes} pf1006_read2_sha256; then
                if test "${pf1006_read1_sha256}" != "${pf1006_read2_sha256}"; then
                  setenv pf1006_result FAIL_READ_HASHES_DIFFER
                fi
              else
                setenv pf1006_result FAIL_HASH
              fi
            else
              setenv pf1006_result FAIL_READS_DIFFER
            fi
          else
            setenv pf1006_result FAIL_SECOND_READ
          fi
        else
          setenv pf1006_result FAIL_FIRST_READ
        fi
      else
        setenv pf1006_result FAIL_BUFFER_INIT
      fi
    else
      setenv pf1006_result FAIL_RESELECT_MMC1
    fi
  else
    setenv pf1006_result FAIL_READING_STATUS
  fi
fi

if test "${pf1006_result}" = RUNNING; then
  setenv pf1006_stage saving_prefix
  if run pf1006_save; then
    if fatwrite mmc 0:1 ${pf1006_a} pf1006-probe.bin ${pf1006_read_bytes}; then
      if fatsize mmc 0:1 pf1006-probe.bin && test "${filesize}" = 400000; then
        if mw.b ${pf1006_b} 0x33 ${pf1006_read_bytes} && fatload mmc 0:1 ${pf1006_b} pf1006-probe.bin ${pf1006_read_bytes}; then
          if test "${filesize}" = 400000 && cmp.b ${pf1006_a} ${pf1006_b} ${pf1006_read_bytes}; then
            setenv pf1006_card_verify equal
          else
            setenv pf1006_result FAIL_CARD_READBACK
          fi
        else
          setenv pf1006_result FAIL_CARD_RELOAD
        fi
      else
        setenv pf1006_result FAIL_CARD_FILE_SIZE
      fi
    else
      setenv pf1006_result FAIL_CARD_SAVE
    fi
  else
    setenv pf1006_result FAIL_SAVING_STATUS
  fi
fi

if test "${pf1006_result}" = RUNNING; then
  setenv pf1006_result VERIFIED_4MIB_PREFIX
  setenv pf1006_stage finished
else
  setenv pf1006_stage failed
fi
# The verifier rejects an absent or incomplete final status. Do not reuse this
# card for another boot: a failed write could leave a previous result in place.
run pf1006_save
# Stop here on success or failure. Do not start Android.
while true; do sleep 60; done
