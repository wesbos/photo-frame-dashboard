# PF1007L boot fixes: settings for one frame.
# Copy to frame-boot.conf, edit, then run: scripts/pf1007l-boot/install.sh apply
# install.sh copies it to /data/local/frame-boot.conf on the frame. Keep your copy private:
# it holds your MAC address and network details. frame-boot.conf is ignored by git.
# Every value is optional. An empty value turns that part off or uses the default shown.

# Wi-Fi MAC address to use at every boot. The AIC8800 has no stored MAC, so the driver picks a new
# random one at each boot. Use a locally administered address (second hex digit 2, 6, A or E).
# Empty: install.sh makes one from the frame's serial number, so it stays the same on reinstall.
MAC=

# NTP server for the clock. Empty: the Wi-Fi gateway from DHCP. Many home routers do not answer
# NTP; if yours does not, set a public server, for example time.google.com.
NTP_SERVER=

# Start Wi-Fi only after boot has finished (1) or leave it to Android (0).
# Starting the AIC8800 in the middle of boot browned out or froze the frame on most boots.
WIFI_DEFER=1
WIFI_DRIVER=/system/vendor/modules/aic8800_fdrv.ko

# Lift the AXP223 power chip's 500 mA input limit early in boot (1) or leave it (0).
# Off by default: it removes the chip's USB current limit, and frames on a laptop or bus-powered
# hub port browned out. Turn it on only with a charger that can supply more than 500 mA.
POWER_FIX=0

# Only allow network ADB (TCP 5555) from this IPv4 network, for example 192.168.1.0/24.
# ADB on this firmware is root with no authentication. Empty: no rule is added.
ADB_ALLOW=

# Allow-list firewall on the frame (1) or none (0). With 1 the frame can only send DHCP, DNS to
# FIREWALL_DNS, NTP (UDP 123) and TCP to each FIREWALL_ALLOW host:port; everything else is refused,
# the rest of your LAN included, and nothing can connect in (ADB_ALLOW still applies). This keeps the
# vendor app and any other app off the internet even when it uses a hard-coded IP, which a DNS block
# can't stop. USB ADB is not affected. Undo: touch /data/local/frame-nofirewall (the loop that
# keeps the rules in place stops within 60 s), then delete the INPUT/OUTPUT jumps or reboot.
# FIREWALL_ALLOW: space-separated host:port, for example "192.168.1.10:8123" for Home Assistant.
# FIREWALL_DNS: the DNS server(s) the frame gets from DHCP, space-separated. Read them with
# `adb shell dumpsys connectivity | grep DnsAddresses` (`getprop net.dns1` came back empty once).
# With either of the two empty, the firewall is not applied (logcat says so).
FIREWALL=0
FIREWALL_ALLOW=
FIREWALL_DNS=

# Drop IPv6 router advertisements on Wi-Fi (1). Use this if your network advertises an IPv6 DNS
# server the frame cannot reach: every DNS lookup then waits 5-10 s for it first.
IGNORE_IPV6_RA=0

# The kiosk activity. If the "Select a Home app" chooser is showing at boot, this activity is
# started instead. Empty: do nothing.
KIOSK=com.wesbos.homehq/.MainActivity
